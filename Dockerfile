# syntax=docker/dockerfile:1.7
# Multi-arch SvxLink server image, built from sm0svx/svxlink source.
# Contract with svxlink-universal-installer: docs/image-contract.md.
#
# The base image is written literally in all three FROM lines (no ARG):
# dependabot's docker parser cannot resolve ARG-parameterized FROMs, so a
# parameterized base would silently opt out of digest-bump PRs.

# =========================================================
# Stage 1 — sounds
# Independent of SVXLINK_REF (its own BuildKit DAG node), so the 14 MB
# voice-pack download re-runs only when the SOUNDS_* pins move, not on
# every upstream commit. Kept first for readability — under BuildKit the
# stage order itself is not what provides the caching.
# =========================================================
FROM debian:trixie-slim AS sounds
ARG SOUNDS_NAME=en_US-heather
ARG SOUNDS_LANG=en_US
ARG SOUNDS_VERSION=25.05
# sha256 of svxlink-sounds-en_US-heather-16k-25.05.tar.bz2 (14,324,550 bytes).
# Recompute at pin time: curl -L <asset> | sha256sum  (see AGENTS.md
# "Bumping the sound pack").
ARG SOUNDS_SHA256=e79e61bec17a24fad093edfb21e7f8ca51af33b9590db954b4789271db2957dd

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl bzip2 \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/sounds.tar.bz2 \
      "https://github.com/sm0svx/svxlink-sounds-${SOUNDS_NAME}/releases/download/${SOUNDS_VERSION}/svxlink-sounds-${SOUNDS_NAME}-16k-${SOUNDS_VERSION}.tar.bz2"; \
    echo "${SOUNDS_SHA256}  /tmp/sounds.tar.bz2" | sha256sum -c -; \
    mkdir -p "/sounds/${SOUNDS_LANG}"; \
    tar -xjf /tmp/sounds.tar.bz2 -C "/sounds/${SOUNDS_LANG}" --strip-components=1; \
    rm /tmp/sounds.tar.bz2; \
    # Loud layout assertion: a pack that unpacks differently must fail the
    # build here, not ship an image with silent voice prompts.
    test -d "/sounds/${SOUNDS_LANG}/Core"

# =========================================================
# Stage 2 — builder
# =========================================================
FROM debian:trixie-slim AS builder
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates \
      cmake g++ make dpkg-dev file groff \
      libsigc++-2.0-dev libgsm1-dev libpopt-dev tcl-dev \
      libgcrypt20-dev libspeex-dev libasound2-dev \
      libopus-dev librtlsdr-dev libjsoncpp-dev \
      libcurl4-openssl-dev libgpiod-dev libogg-dev \
      ladspa-sdk libssl-dev \
 && rm -rf /var/lib/apt/lists/*

ARG SVXLINK_GIT_URL=https://github.com/sm0svx/svxlink.git
# ALWAYS a full commit SHA in CI (tags also accepted for local builds).
# git init + fetch, NOT `clone --depth 1 --branch`, because --branch rejects
# raw SHAs — this is what lets the workflows pass the gate-resolved SHA as
# the actual build ref, closing the "master moved between gate and clone"
# race the signalk-server-images reference has.
ARG SVXLINK_REF
WORKDIR /build/svxlink
RUN set -eux; \
    test -n "${SVXLINK_REF}"; \
    git init .; \
    git remote add origin "${SVXLINK_GIT_URL}"; \
    git fetch --depth=1 origin "${SVXLINK_REF}"; \
    git checkout --detach FETCH_HEAD

RUN set -eux; \
    # PROJECT= is the real project version key in src/versions.
    # f4hlv scrapes SVXSERVER= (an unrelated helper stuck at 0.0.7) — do NOT
    # copy that.
    SVX_VER="$(sed -n 's/^PROJECT=//p' src/versions | tr -d '[:space:]')"; \
    test -n "${SVX_VER}"; \
    echo "svxlink PROJECT version: ${SVX_VER}"; \
    cmake -S src -B build \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_SYSCONFDIR=/etc \
      -DCMAKE_INSTALL_LOCALSTATEDIR=/var \
      -DUSE_QT=OFF \
      -DCMAKE_BUILD_TYPE=Release \
      -DCPACK_GENERATOR=DEB \
      -DCPACK_DEBIAN_PACKAGE_SHLIBDEPS=ON \
      -DCPACK_PACKAGE_VERSION="${SVX_VER}" \
      -DCPACK_DEBIAN_PACKAGE_VERSION="${SVX_VER}"; \
    make -C build -j"$(nproc)"; \
    make -C build package; \
    # Directory, not a single-file glob target: CPack may emit one OR many
    # .debs; f4hlv's `COPY build/*.deb /tmp/svxlink.deb` silently breaks on >1.
    mkdir /out; \
    cp build/*.deb /out/; \
    ls -lh /out/

# =========================================================
# Stage 3 — runtime
# =========================================================
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive

# Deliberately short list — shared-library deps come from the .deb's
# Depends (generated by SHLIBDEPS), so this can never skew against what the
# binaries actually link (f4hlv hand-maintains an incomplete list instead).
# tzdata: honors the quadlet's Timezone=local (f4hlv's TZ env was dead).
# procps: pgrep for `svx health` in-container probes.
# alsa-utils: aplay/arecord diagnostics for the audio wizard.
# init-system-helpers: deb postinst calls deb-systemd-invoke.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata procps alsa-utils init-system-helpers \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/ /tmp/debs/
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/debs/*.deb; \
    rm -rf /tmp/debs /var/lib/apt/lists/*; \
    # Contract: /var/log/svxlink exists (the deb does not create it; without
    # this, only podman's bind-mount auto-create and the entrypoint's
    # mkdir -p papered over the gap).
    mkdir -p /var/log/svxlink; \
    # Loud smoke assertion (the canSocket.node analogue): if SHLIBDEPS ever
    # under-declares a runtime lib, the linker fails HERE, not on the user's
    # repeater.
    svxlink --version

# Baked, pinned voice pack. Mount-point contract: a language override is a
# host dir mounted at /usr/share/svxlink/sounds/<LANG> (shadows/adds exactly
# one language). NEVER mount /usr/share/svxlink or .../sounds wholesale —
# that hides the TCL events.d handlers / this baked pack (f4hlv's compose
# file makes exactly that mistake).
COPY --from=sounds /sounds/ /usr/share/svxlink/sounds/

# No USER directive: the container runs as root-in-userns. Under rootless
# podman, container uid 0 == the invoking host user, so bind-mounted
# ~/.svxlink/{etc,log} stay host-user-owned with no chown dance, and we never
# need UserNS=keep-id (whose combination with --device + keep-groups yields
# nobody:nobody device nodes — podman#28364). Device access comes from the
# host user's supplementary groups via the quadlet's GroupAdd=keep-groups.
#
# LC_ALL=C is deliberate and load-bearing: the CN8VX dashboard parses
# month-name log timestamps with C-locale regexes. Do not install `locales`.
# SVXLINK_CONF is NOT set here: the entrypoint defaults it per program
# (/etc/svxlink/<prog>.conf) so `podman run ... remotetrx` picks the right
# file; a global ENV would pin remotetrx to svxlink.conf.
ENV LC_ALL=C \
    SVXLINK_LOGFILE= \
    SVXLINK_LOG_MAXSIZE=10485760

COPY entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

# EchoLink inbound: 5198/5199 udp. 5200/tcp is an OUTBOUND connection to the
# EchoLink directory server — publishing it is a no-op, so it is deliberately
# not EXPOSEd. (Documentation only anyway: the installer runs Network=host.)
EXPOSE 5198/udp 5199/udp

# No HEALTHCHECK: under Quadlet it would spawn a per-container transient
# timer every 30 s with no consumer acting on "unhealthy" — `svx health`
# probes independently from the host.

WORKDIR /var/lib/svxlink
ENTRYPOINT ["/entrypoint.sh"]
CMD ["svxlink"]
